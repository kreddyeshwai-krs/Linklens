# Server Environment
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Threat Intelligence Provider (e.g. google, virustotal)
# Leave empty to use local explainable heuristics without external third-party lookup
THREAT_INTELLIGENCE_PROVIDER=
THREAT_INTELLIGENCE_API_KEY=

# Rate Limiting Configuration
SCAN_RATE_LIMIT_WINDOW_MS=900000
SCAN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# JWT & Session Secret for local dev authentication
JWT_SECRET=linklens_dev_jwt_secret_change_in_production_min32chars

